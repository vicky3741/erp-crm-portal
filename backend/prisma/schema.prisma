// ---------------------------------------------------------------------------
// Mini ERP + CRM Operations Portal — data model
//
// Design notes that matter for the business rules:
//  * Money is stored as Decimal(12,2), never Float, so totals stay exact.
//  * ChallanItem copies the product name / SKU / price at the moment the
//    challan is created. A challan is a historical document: editing or
//    deleting a product later must not rewrite what was already dispatched.
//  * Every change to Product.currentStock is mirrored by a StockMovement row
//    written inside the same transaction, so stock is always auditable.
//  * Deletes are soft (isActive = false) because challans and stock history
//    reference these rows.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- enums ---------------------------------------

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ----------------------------- users ---------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersCreated  Customer[]      @relation("CustomerCreatedBy")
  followUpsCreated  FollowUp[]      @relation("FollowUpCreatedBy")
  stockMovements    StockMovement[] @relation("StockMovementCreatedBy")
  challansCreated   Challan[]       @relation("ChallanCreatedBy")
  challansConfirmed Challan[]       @relation("ChallanConfirmedBy")
  challansCancelled Challan[]       @relation("ChallanCancelledBy")

  @@index([role])
  @@map("users")
}

// --------------------------- customers (CRM) --------------------------------

model Customer {
  id           String         @id @default(cuid())
  name String
  // Mobile is how this business identifies a customer, so it is unique at the
  // database level rather than only checked in application code — two
  // concurrent creates cannot both slip through.
  mobile       String @unique
  email        String
  businessName String
  gstNumber    String? // optional per the spec
  customerType CustomerType
  address      String
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdById String
  createdBy   User   @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  followUps FollowUp[]
  challans  Challan[]

  @@index([name])
  @@index([status])
  @@index([customerType])
  @@index([followUpDate])
  @@index([isActive])
  @@map("customers")
}

model FollowUp {
  id           String    @id @default(cuid())
  note         String
  followUpDate DateTime?
  createdAt    DateTime  @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("follow_ups")
}

// ----------------------- products & inventory -------------------------------

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  category      String
  unitPrice     Decimal  @db.Decimal(12, 2)
  currentStock  Int      @default(0)
  minStockAlert Int      @default(0)
  location      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([name])
  @@index([category])
  @@index([isActive])
  @@map("products")
}

model StockMovement {
  id             String       @id @default(cuid())
  quantityChanged Int // always positive; movementType carries the direction
  movementType   MovementType
  reason         String
  balanceAfter   Int // stock level immediately after this movement
  referenceType  String? // e.g. "CHALLAN"
  referenceId    String? // e.g. the challan id that caused it
  createdAt      DateTime     @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

// --------------------------- sales challans ---------------------------------

model Challan {
  id            String        @id @default(cuid())
  challanNumber String        @unique
  status        ChallanStatus @default(DRAFT)

  // Customer snapshot — kept alongside the FK so the document still reads
  // correctly if the customer record is later edited.
  customerName         String
  customerMobile       String
  customerBusinessName String

  totalQuantity Int      @default(0)
  totalAmount   Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("ChallanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  confirmedById String?
  confirmedBy   User?   @relation("ChallanConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  cancelledById String?
  cancelledBy   User?   @relation("ChallanCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  items ChallanItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id String @id @default(cuid())

  // Snapshot of the product as it was when the challan was raised.
  productName     String
  productSku      String
  productCategory String
  unitPrice       Decimal @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal @db.Decimal(12, 2)

  challanId String
  challan   Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // One line per product per challan; quantities are merged instead of duplicated.
  @@unique([challanId, productId])
  @@index([challanId])
  @@map("challan_items")
}

/// Hands out challan numbers of the form CH-YYYYMM-0001.
/// Incremented inside the same transaction that creates the challan, so two
/// concurrent requests can never receive the same number.
model ChallanSequence {
  period     String @id // "YYYYMM"
  lastNumber Int    @default(0)

  @@map("challan_sequences")
}
