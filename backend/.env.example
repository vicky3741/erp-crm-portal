# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on. Render injects its own PORT in production.
PORT=4000

# PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/erp_crm
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/erp_crm

# Secret used to sign JWTs. Minimum 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# bcrypt cost factor (10 is a good default).
BCRYPT_SALT_ROUNDS=10
